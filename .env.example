# ---------- Server (read by server/src/index.ts via dotenv) ----------
# Port the HTTP + Socket.IO server listens on
PORT=4000

# Comma separated list of allowed browser origins, or * to allow any.
# In development the Vite dev server runs on 5173.
CLIENT_ORIGIN=http://localhost:5173

# Where room snapshots are written so games survive a server restart
DATA_DIR=./data

# Minutes an abandoned room is kept before it is destroyed
ROOM_TTL_MINUTES=45

# ---------- Client (read by Vite, must be prefixed with VITE_) ----------
# Where the browser should reach the game server.
#
# Leave this unset for both normal setups:
#   - in development the Vite dev server proxies /api and /socket.io to PORT
#   - in the production build one process serves the client and the sockets
#
# Only set it when the client is hosted separately from the server, for
# example on a CDN talking to an API on another domain:
# VITE_SERVER_URL=https://api.example.com
